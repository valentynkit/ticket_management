  "db_name": "PostgreSQL",
  "query": "\n            UPDATE tickets\n            SET title       = COALESCE($2, title),\n                description = COALESCE($3, description),\n                status      = COALESCE($4, status),\n                updated_at  = now()\n            WHERE id = $1\n            RETURNING id AS \"id: TicketId\", \n            title AS \"title: Title\", \n            description AS \"description: Description\",\n            status AS \"status: Status\", \n            updated_at, \n            created_at\n        ",
