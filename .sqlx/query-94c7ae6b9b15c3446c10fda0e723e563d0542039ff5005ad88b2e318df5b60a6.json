  "query": "\n            SELECT id AS \"id: TicketId\",\n                   title AS \"title: Title\",\n                   description AS \"description: Description\",\n                   status AS \"status: Status\",\n                   created_at,\n                   updated_at\n            FROM tickets\n            WHERE $1::uuid IS NULL OR id > $1\n            ORDER BY id\n            LIMIT $2\n        ",
